@startuml
left to right direction
skinparam defaultFontName Arial
skinparam shadowing false
skinparam dpi 150
title Диаграмма прецедентов
actor "Сотрудник\nучебного отдела" as Staff
rectangle "Университетская информационная система" {
  usecase "UC-01 · Просмотреть структуру\nи численность" as UC01
  usecase "UC-02 · Зарегистрировать\nнаучного сотрудника" as UC02
  usecase "UC-03 · Назначить участие\nв проекте" as UC03
  usecase "UC-04 · Закрепить курс\nза преподавателем" as UC04
  usecase "UC-05 · Просмотреть нагрузку\nнаучного сотрудника" as UC05
}
Staff -- UC01
Staff -- UC02
Staff -- UC03
Staff -- UC04
Staff -- UC05
@enduml
